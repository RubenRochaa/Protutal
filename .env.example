DATABASE_URL="postgresql..."

Secret JWT https://www.md5hashgenerator.com/
JWT_SECRET=...

# Cloudinary
CLOUDINARY_NAME=...
CLOUDINARY_KEY=...
CLOUDINARY_SECRET=...

base_url = http://localhost:3333/

# Domínios de e-mail aceitos no cadastro, separados por vírgula
DOMINIOS_PERMITIDOS_PROFESSOR=...org.br
DOMINIOS_PERMITIDOS_ALUNO=...org.br

# Envio do e-mail de confirmação do cadastro (Nodemailer + Gmail)
# EMAIL_PASS é uma senha de app do Google, não a senha normal da conta
EMAIL_USER=...@gmail.com
EMAIL_PASS=...
# Endereço base da API, usado para montar o link de confirmação
APP_URL=http://localhost:3333